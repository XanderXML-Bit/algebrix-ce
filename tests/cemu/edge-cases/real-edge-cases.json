      "name": "edge_division_by_zero",
      "suite": "edge_cases",
      "category": "arithmetic",
      "backend": "real",
      "description": "Division by zero produces the locked real-ROM error screen.",
      "expected_display": "ERR:DIVIDE BY 0",
      "expected_crcs": ["32BFD188"],
      "input_tokens": ["1", "/", "0"],
      "timeout_ms": 30000,
      "result_delay_ms": 3000,
      "notes": "Real-ROM baseline captured on 2026-03-25."
    },
