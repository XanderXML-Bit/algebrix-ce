# ----------------------------
# CalcEngine - TI-84 Plus CE Math Suite
# Zendren LLC
# ----------------------------

# Hardware build mode:
#   HW_BUILD=1 (default): multi-program split architecture
#   HW_BUILD=0           : legacy monolithic program
HW_BUILD ?= 1

# Version (override with: make V_MAJOR=2 V_MINOR=1 V_PATCH=0)
V_MAJOR ?= 2
V_MINOR ?= 0
V_PATCH ?= 1

ifeq ($(HW_BUILD),1)

SPLIT_MODULES := launcher algebra calculus limits_series matrix stats_prob finance graphing lists_complex
WORKER_MODULES := base algf algsy algeo algpdv algsolve algsolve.adv \
                  calc.lim calc.lim.base calc.lim.adv calc.lim.cont calc.lim.rel \
                  calc.int calc.int.def calc.int.simple calc.int.adv \
                  calc.int.parts calc.int.trig calc.int.usub calc.int.pfrac calc.int.report \
                  calc.ode calc.series calc.seq calc.pol calc.pol.num

# Stack-usage checker: scan .su files generated by -fstack-usage.
# Fails the build if any function allocates >= STACK_THRESHOLD bytes locally.
ifeq ($(OS),Windows_NT)
STACK_CHECKER     ?= python tools/check_stack.py
else
STACK_CHECKER     ?= python3 tools/check_stack.py
endif
STACK_SEARCH_DIRS ?= obj
STACK_THRESHOLD   ?= 1024
STACK_EXPECT_COUNT := $(words $(SPLIT_MODULES) $(WORKER_MODULES))

.PHONY: all split-suite split-workers clean desktop-tests check-stack \
        emulator-test op-dispatch-parity test \
        $(addprefix split-,$(SPLIT_MODULES)) \
        $(addprefix clean-,$(SPLIT_MODULES)) \
        $(addprefix worker-,$(WORKER_MODULES)) \
        $(addprefix clean-worker-,$(WORKER_MODULES)) \
        split-core split-base split-alg split-algf split-algsy split-algeo split-calc split-calc-tan split-calc-lim split-calc-int split-calc-pol split-calc-series split-calc-seq split-stat split-prob split-mat split-graph split-fin split-cmplx split-tmpcalc \
        clean-core clean-base clean-alg clean-algf clean-algsy clean-algeo clean-calc clean-calc-tan clean-calc-lim clean-calc-int clean-calc-pol clean-calc-series clean-calc-seq clean-stat clean-prob clean-mat clean-graph clean-fin clean-cmplx clean-tmpcalc

all: check-stack

split-suite: split-workers $(addprefix split-,$(SPLIT_MODULES))

split-workers: $(addprefix worker-,$(WORKER_MODULES))

# Post-build stack guard: runs after all modules are built.
# The -fstack-usage flag writes .su files alongside .o files in each module's
# obj/$(NAME) directory. Require one LTO report for every module.
# No shell wrapper: make reports the checker's own status (1 = violations,
# 2 = missing or invalid evidence), and the checker prints its own diagnostics.
# The dependency also orders the guard after builds under parallel make.
check-stack: split-suite
	@echo "--- Stack usage check (threshold=$(STACK_THRESHOLD) B) ---"
	@$(STACK_CHECKER) --threshold $(STACK_THRESHOLD) --expect-count $(STACK_EXPECT_COUNT) $(STACK_SEARCH_DIRS)

# Clear the former shared obj/ layout after every module clean finishes.
clean: $(addprefix clean-,$(SPLIT_MODULES)) $(addprefix clean-worker-,$(WORKER_MODULES))
	$(MAKE) -f split/Makefile.launcher clean OBJDIR=obj

define SPLIT_MODULE_RULE
split-$(1):
	$$(MAKE) -f split/Makefile.$(1) clean V_MAJOR=$$(V_MAJOR) V_MINOR=$$(V_MINOR) V_PATCH=$$(V_PATCH)
	$$(MAKE) -f split/Makefile.$(1) V_MAJOR=$$(V_MAJOR) V_MINOR=$$(V_MINOR) V_PATCH=$$(V_PATCH)

clean-$(1):
	$$(MAKE) -f split/Makefile.$(1) clean V_MAJOR=$$(V_MAJOR) V_MINOR=$$(V_MINOR) V_PATCH=$$(V_PATCH)
endef

$(foreach module,$(SPLIT_MODULES),$(eval $(call SPLIT_MODULE_RULE,$(module))))

define WORKER_MODULE_RULE
worker-$(1):
	$$(MAKE) -f split/Makefile.$(1) clean V_MAJOR=$$(V_MAJOR) V_MINOR=$$(V_MINOR) V_PATCH=$$(V_PATCH)
	$$(MAKE) -f split/Makefile.$(1) V_MAJOR=$$(V_MAJOR) V_MINOR=$$(V_MINOR) V_PATCH=$$(V_PATCH)

clean-worker-$(1):
	$$(MAKE) -f split/Makefile.$(1) clean V_MAJOR=$$(V_MAJOR) V_MINOR=$$(V_MINOR) V_PATCH=$$(V_PATCH)
endef

$(foreach module,$(WORKER_MODULES),$(eval $(call WORKER_MODULE_RULE,$(module))))

desktop-tests:
	$(MAKE) -C tests run

# Run the emulator-gated CEmu test suite (tests/cemu/).
# Tests auto-skip when cemu-headless binary, ROM, arTIfiCE, or module files
# are absent, so this target is safe to call in CI without the hardware stack.
# Use PYTEST_ARGS to pass extra flags, e.g.:
#   make emulator-test PYTEST_ARGS="-k phase2 -v"
PYTEST        ?= python -m pytest
EMULATOR_TESTS ?= tests/cemu

emulator-test:
	@echo "--- Emulator test suite ($(EMULATOR_TESTS)) ---"
	$(PYTEST) $(EMULATOR_TESTS) -q $(PYTEST_ARGS)

# Host check that every operator reaches a module compiled with its handler
# (tests/cemu/test_op_dispatch_parity.py; needs a host C compiler and pytest).
# CI runs it in the cemu-python job, which runs all of tests/cemu.
op-dispatch-parity:
	$(PYTEST) tests/cemu/test_op_dispatch_parity.py -q $(PYTEST_ARGS)

# Host test suites that need no CE toolchain: the desktop suite and the
# operator dispatch check.
test: desktop-tests op-dispatch-parity

# Legacy split target aliases
split-core: split-launcher
split-base: split-algebra
split-alg: split-algebra
split-algf: split-algebra
split-algsy: split-algebra
split-algeo: split-algebra
split-calc: split-calculus
split-calc-tan: split-calculus
split-calc-lim: split-limits_series
split-calc-int: split-calculus
split-calc-pol: split-calculus
split-calc-series: split-limits_series
split-calc-seq: split-limits_series
split-stat: split-stats_prob
split-prob: split-stats_prob
split-mat: split-matrix
split-graph: split-graphing
split-fin: split-finance
split-cmplx: split-lists_complex
split-tmpcalc: split-calculus

clean-core: clean-launcher
clean-base: clean-algebra
clean-alg: clean-algebra
clean-algf: clean-algebra
clean-algsy: clean-algebra
clean-algeo: clean-algebra
clean-calc: clean-calculus
clean-calc-tan: clean-calculus
clean-calc-lim: clean-limits_series
clean-calc-int: clean-calculus
clean-calc-pol: clean-calculus
clean-calc-series: clean-limits_series
clean-calc-seq: clean-limits_series
clean-stat: clean-stats_prob
clean-prob: clean-stats_prob
clean-mat: clean-matrix
clean-graph: clean-graphing
clean-fin: clean-finance
clean-cmplx: clean-lists_complex
clean-tmpcalc: clean-calculus

else

NAME = CALCENG
DESCRIPTION = "CalcEngine Math Suite"
COMPRESSED = NO
ARCHIVED = YES

# CE-safe printf (src/ce_fmt.c, picked up from SRCDIR); see split/program.mk.
# The legacy monolithic build is not part of make all and is not tested.
CFLAGS = -Wall -Wextra -Oz -include src/ce_fmt.h \
         -DCE_VERSION_MAJOR=$(V_MAJOR) \
         -DCE_VERSION_MINOR=$(V_MINOR) \
         -DCE_VERSION_PATCH=$(V_PATCH)
CXXFLAGS = -Wall -Wextra -Oz

include $(shell cedev-config --makefile)

endif
