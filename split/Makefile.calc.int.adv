NAME = CECIAD
DESCRIPTION = "CalcEngine Integral Advanced Dispatcher"
BINDIR = bin/calc_int_adv

PROGRAM_CFLAGS = -DHW_BUILD_SPLIT \
    -DCE_DISABLE_STEP_RECORDING=1 \
    -DCE_AST_ENABLE_STAT_NAMES=0

PROGRAM_SOURCES = \
    src/modules/calc_int/adv_main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/memory.c \
    src/ast.c

PROGRAM_RUNTIME_SOURCES = src/split/module_forward.c

include split/program.mk
