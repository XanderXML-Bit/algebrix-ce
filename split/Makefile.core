NAME = CALCENG
DESCRIPTION = "CalcEngine Core Launcher"
BINDIR = bin/core

PROGRAM_CFLAGS = -DHW_BUILD_SPLIT -DCE_AST_ENABLE_STAT_NAMES=0 -DCE_UI_MINIMAL_PRETTY=1
PROGRAM_SOURCES = \
    src/split/core_main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/classify.c \
    src/memory.c \
    src/token.c \
    src/ast.c \
    src/parser.c \
    src/macros.c \
    src/steps.c \
    src/ui.c \
    src/mathprint.c

include split/program.mk
