NAME = CALCENG
DESCRIPTION = "CalcEngine Core Launcher"
BINDIR = bin/launcher
COMPRESSED = YES

PROGRAM_CFLAGS = -DHW_BUILD_SPLIT -DCE_AST_ENABLE_STAT_NAMES=0 -DCE_LAUNCHER_TINY_ERRORS=1
PROGRAM_SOURCES = \
    src/core/launcher/main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/classify.c \
    src/memory.c \
    src/token.c \
    src/ast.c \
    src/parser.c

include split/program.mk
