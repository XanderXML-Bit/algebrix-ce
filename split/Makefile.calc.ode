NAME = CECODE
DESCRIPTION = "CalcEngine ODE Worker"
BINDIR = bin/calc_ode

# Links simplify.c (CE_INTEG_USE_SIMPLIFY=1), as the desktop build does.
# Without it results printed as ((X^(2+1))/(2+1)).  SIMPLIFY_MAX_DEPTH=24
# bounds the simplifier's recursion on the 4 KB OS stack, as in CECALC.
# DIFF_MAX_DEPTH=36 does the same for diff(), which the linear-ODE split
# runs on the whole right-hand side: at the default 50, diffeq(y+x+x+...)
# with 57 terms left only 510 B of stack (internal review).  INTEG_MAX_DEPTH=48
# (default 64): the answer is printed under the processor's 256 B result
# buffer, and an integral at the default cap left 449 B.  ODE sums past ~54
# terms run out of pool nodes anyway.
# tests/cemu/test_module_flag_parity.py runs this module's code on the
# desktop with these exact flags.
PROGRAM_CFLAGS = -DHW_BUILD_SPLIT \
    -DCE_DISABLE_STEP_RECORDING=1 \
    -DCE_AST_ENABLE_STAT_NAMES=0 \
    -DCE_PROC_ALG=0 -DCE_PROC_ALG_BASIC=0 -DCE_PROC_ALG_EXPFAC=0 -DCE_PROC_ALG_SOLVE=0 -DCE_PROC_ALG_POLYDIV=0 \
    -DCE_PROC_ALG_ADV=0 -DCE_PROC_ALG_ADV_SYM=0 -DCE_PROC_ALG_ADV_GEO=0 \
    -DCE_PROC_CALC=0 -DCE_PROC_CALC_BASE=0 -DCE_PROC_CALC_DERIV=0 -DCE_PROC_CALC_TANGENT=0 -DCE_PROC_CALC_LIMIT=0 \
    -DCE_PROC_CALC_INT=0 -DCE_PROC_CALC_INT_SYMBOLIC=0 -DCE_PROC_CALC_INT_DEFINITE=0 -DCE_PROC_CALC_INT_POLAR=0 \
    -DCE_PROC_CALC_ODE=1 \
    -DCE_PROC_CALC_SERIES=0 -DCE_PROC_CALC_SERIES_TF=0 -DCE_PROC_CALC_SERIES_SEQ=0 \
    -DCE_PROC_STAT=0 -DCE_PROC_FIN=0 -DCE_PROC_MATRIX=0 -DCE_PROC_CMPLX=0 -DCE_PROC_GRAPH=0 \
    -DCE_PROC_GENERIC=0 -DCE_PROC_USE_CLASSIFY=0 -DCE_PROC_PARSE_INPUT=0 \
    -DCE_INTEG_USE_SIMPLIFY=1 -DSIMPLIFY_MAX_DEPTH=24 -DDIFF_MAX_DEPTH=36 -DINTEG_MAX_DEPTH=48 \
    -DCE_INTEG_ENABLE_STRATEGY_API=0 \
    -DCE_INTEG_ENABLE_STRATEGY_REPORT=0 \
    -DCE_INTEG_ENABLE_ODE=1 \
    -DCE_INTEG_ENABLE_DEFINITE=0 \
    -DCE_INTEG_ENABLE_NONLINEAR_USUB=0 \
    -DCE_INTEG_ENABLE_TRIG_SUB=0 \
    -DCE_INTEG_ENABLE_PARTIAL_FRAC=0 \
    -DCE_INTEG_ENABLE_CYCLIC_PARTS=0 \
    -DCE_INTEG_ENABLE_PARTS=0 \
    -DCE_DERIV_USE_SIMPLIFY=0 -DCE_DERIV_USE_EVAL=0 \
    -DCE_EVAL_ENABLE_NODE_STAT=0 \
    -DCE_EVAL_ENABLE_NODE_LIST=0 \
    -DCE_EVAL_ENABLE_ADV_POLAR=0 \
    -DCE_EVAL_ENABLE_POLYDIV=0

PROGRAM_SOURCES = \
    src/split/module_main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/processor.c \
    src/memory.c \
    src/ast.c \
    src/eval.c \
    src/integrate.c \
    src/deriv.c \
    src/simplify.c

include split/program.mk
