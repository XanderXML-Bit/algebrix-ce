NAME = CECLMB
DESCRIPTION = "CalcEngine Limit Base Worker"
BINDIR = bin/calc_lim_base

# Retain canonical auxiliary AST text within the 51,200 B ceiling.
PROGRAM_CFLAGS = -DHW_BUILD_SPLIT \
    -DCE_AST_DISPLAY_PRINT=0 \
    -DCE_EVAL_MAX_DEPTH=12 -DCE_POLY_MAX_DEPTH=8 \
    -DCE_EVAL_RECORD_STEPS=0 \
    -DCE_AST_ENABLE_STAT_NAMES=0 \
    -DCE_PROC_ALG=0 -DCE_PROC_ALG_BASIC=0 -DCE_PROC_ALG_EXPFAC=0 -DCE_PROC_ALG_SOLVE=0 -DCE_PROC_ALG_POLYDIV=0 \
    -DCE_PROC_ALG_ADV=0 -DCE_PROC_ALG_ADV_SYM=0 -DCE_PROC_ALG_ADV_GEO=0 \
    -DCE_PROC_CALC=0 -DCE_PROC_CALC_BASE=0 -DCE_PROC_CALC_DERIV=0 -DCE_PROC_CALC_TANGENT=0 -DCE_PROC_CALC_LIMIT=1 \
    -DCE_PROC_CALC_LIMIT_CONTINUITY=0 -DCE_PROC_CALC_LIMIT_RELRATE=0 \
    -DCE_PROC_CALC_INT=0 -DCE_PROC_CALC_INT_SYMBOLIC=0 -DCE_PROC_CALC_INT_POLAR=0 \
    -DCE_PROC_CALC_SERIES=0 -DCE_PROC_CALC_SERIES_TF=0 -DCE_PROC_CALC_SERIES_SEQ=0 \
    -DCE_PROC_STAT=0 -DCE_PROC_FIN=0 -DCE_PROC_MATRIX=0 -DCE_PROC_CMPLX=0 -DCE_PROC_GRAPH=0 \
    -DCE_PROC_GENERIC=0 -DCE_PROC_USE_CLASSIFY=0 -DCE_PROC_USE_EVAL=0 -DCE_PROC_PARSE_INPUT=0 \
    -DCE_LIMITS_USE_SIMPLIFY=0 \
    -DCE_LIMITS_ENABLE_SHIFTED_SPECIAL=0 \
    -DCE_LIMITS_ENABLE_FACTOR_CANCEL=0 \
    -DCE_LIMITS_ENABLE_RATIONALIZE=0 \
    -DCE_LIMITS_ENABLE_LHOPITAL=1 \
    -DCE_LIMITS_ENABLE_ZERO_TIMES_INF=1 \
    -DCE_LIMITS_ENABLE_SPLIT_RULES=0 \
    -DCE_PROC_CALC_LIMIT_ROUTE_ADV=1 \
    -DCE_DERIV_USE_SIMPLIFY=0 -DCE_DERIV_USE_EVAL=0 -DCE_ALG_USE_SIMPLIFY=0 \
    -DCE_EVAL_ENABLE_NODE_STAT=0 \
    -DCE_EVAL_ENABLE_NODE_LIST=0 \
    -DCE_EVAL_ENABLE_ADV_POLAR=0 \
    -DCE_EVAL_ENABLE_POLYDIV=0

PROGRAM_SOURCES = \
    src/modules/calc_lim/simple_main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/processor.c \
    src/memory.c \
    src/ast.c \
    src/steps.c \
    src/eval.c \
    src/limits.c \
    src/deriv.c \
    src/split/algebra_poly.c

PROGRAM_RUNTIME_SOURCES = src/split/module_forward.c

include split/program.mk
