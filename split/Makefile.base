NAME = CEBASE
DESCRIPTION = "CalcEngine Basic Eval Module"
BINDIR = bin/base

# CE_SAFE_FLOAT=1: plain arithmetic runs here, so it uses the overflow-safe
# float helpers (src/ce_float_ops.h, about 2.3 KB); the CE's own float
# routines wrap (1E38*10 gave 2.35e-38).
# CE_SAFE_FLOAT_TINY=1: those helpers also refuse tiny arithmetic ("Tiny
# value unsupported") instead of letting the CE flush or garble a value
# below FLT_MIN, and a nonzero result below 1e-6 prints in scientific form.
PROGRAM_CFLAGS = -DHW_BUILD_SPLIT -DCE_SAFE_FLOAT=1 -DCE_SAFE_FLOAT_TINY=1 -DCE_EVAL_SUM_COMPENSATED=1 \
    -DCE_AST_ENABLE_STAT_NAMES=0 \
    -DCE_PROC_ALG=0 -DCE_PROC_ALG_BASIC=0 -DCE_PROC_ALG_SOLVE=0 -DCE_PROC_ALG_ADV=0 \
    -DCE_PROC_CALC=0 -DCE_PROC_CALC_BASE=0 -DCE_PROC_CALC_DERIV=0 -DCE_PROC_CALC_TANGENT=0 -DCE_PROC_CALC_LIMIT=0 \
    -DCE_PROC_CALC_INT=0 -DCE_PROC_CALC_INT_SYMBOLIC=0 -DCE_PROC_CALC_INT_POLAR=0 \
    -DCE_PROC_CALC_SERIES=0 -DCE_PROC_CALC_SERIES_TF=0 -DCE_PROC_CALC_SERIES_SEQ=0 \
    -DCE_PROC_STAT=0 -DCE_PROC_FIN=0 -DCE_PROC_MATRIX=0 -DCE_PROC_CMPLX=0 -DCE_PROC_GRAPH=0 -DCE_PROC_GENERIC=1 -DCE_PROC_USE_CLASSIFY=0 -DCE_PROC_PARSE_INPUT=0 \
    -DCE_EVAL_ENABLE_NODE_STAT=0 \
    -DCE_EVAL_ENABLE_NODE_LIST=0 \
    -DCE_EVAL_ENABLE_ADV_POLAR=0 \
    -DCE_EVAL_ENABLE_POLYDIV=0 \
    -DCE_EVAL_USER_VARS=1 -DCE_EVAL_MAX_DEPTH=16

PROGRAM_SOURCES = \
    src/split/module_main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/processor.c \
    src/memory.c \
    src/ast.c \
    src/steps.c \
    src/eval.c

include split/program.mk
