NAME = CELSCX
DESCRIPTION = "CalcEngine Lists and Complex Module"
COMPRESSED = YES
BINDIR = bin/lists_complex

PROGRAM_CFLAGS = -DCE_EVAL_SUM_DIRECT_DISPATCH=1 -DCE_EVAL_SUM_COMPENSATED=1 -DHW_BUILD_SPLIT \
    -DCE_AST_ENABLE_STAT_NAMES=0 \
    -DCE_PROC_ALG=0 -DCE_PROC_ALG_BASIC=0 -DCE_PROC_ALG_EXPFAC=0 -DCE_PROC_ALG_SOLVE=0 -DCE_PROC_ALG_POLYDIV=0 \
    -DCE_PROC_ALG_ADV=0 -DCE_PROC_ALG_ADV_SYM=0 -DCE_PROC_ALG_ADV_GEO=0 \
    -DCE_PROC_CALC=0 -DCE_PROC_CALC_BASE=0 -DCE_PROC_CALC_DERIV=0 -DCE_PROC_CALC_TANGENT=0 -DCE_PROC_CALC_LIMIT=0 \
    -DCE_PROC_CALC_INT=0 -DCE_PROC_CALC_INT_SYMBOLIC=0 -DCE_PROC_CALC_INT_POLAR=0 \
    -DCE_PROC_CALC_SERIES=0 -DCE_PROC_CALC_SERIES_TF=0 -DCE_PROC_CALC_SERIES_SEQ=0 \
    -DCE_PROC_STAT=0 -DCE_PROC_FIN=0 -DCE_PROC_MATRIX=0 -DCE_PROC_CMPLX=1 -DCE_PROC_GRAPH=0 \
    -DCE_PROC_GENERIC=1 -DCE_PROC_USE_CLASSIFY=0 -DCE_PROC_PARSE_INPUT=0 \
    -DCE_EVAL_ENABLE_NODE_STAT=0 \
    -DCE_EVAL_ENABLE_NODE_LIST=1 \
    -DCE_EVAL_ENABLE_ADV_POLAR=0 \
    -DCE_EVAL_ENABLE_POLYDIV=0 \
    -DCE_EVAL_USER_VARS=1 -DCE_EVAL_MAX_DEPTH=8 \
    -DCE_EVAL_STACK_RESERVE=960u

# CE_EVAL_STACK_RESERVE (src/eval.c backstop, default 832 B, sized for
# CEBASE): a "...->A" store of a value with a list or complex part, or of a
# single command such as sum( or int(, runs here, so nested int/sum/lim reach the
# backstop. Below the last eval level that passes it, CELSCX spends about
# 307 B (eval_node + eval_numeric_integral + the refused call); measured on
# the OS 5.8 ROM at 21 B steps, 832 B left 525 B, so possibly under 512 B
# between steps. 960 B leaves at least 600 B (internal review).

PROGRAM_SOURCES = \
    src/modules/lists_complex/main.c \
    src/modules/common/module_entry.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/processor.c \
    src/memory.c \
    src/ast.c \
    src/steps.c \
    src/eval.c \
    src/list.c \
    src/complex.c

include split/program.mk
