NAME = TMPMOD
DESCRIPTION = "tmp"
BINDIR = bin/tmp
PROGRAM_CFLAGS = -DHW_BUILD_SPLIT -DCE_AST_ENABLE_STAT_NAMES=0 -DCE_PROC_PARSE_INPUT=0 -DCE_PROC_USE_CLASSIFY=0 -DCE_PROC_GENERIC=0 -DCE_EVAL_ENABLE_NODE_STAT=0 -DCE_EVAL_ENABLE_NODE_LIST=0 -DCE_EVAL_ENABLE_ADV_POLAR=0 -DCE_EVAL_ENABLE_POLYDIV=1 $(EXTRA_FLAGS)
PROGRAM_SOURCES = \
    src/split/module_main.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/processor.c \
    src/memory.c \
    src/ast.c \
    src/steps.c \
    $(EXTRA_SOURCES)
include split/program.mk
