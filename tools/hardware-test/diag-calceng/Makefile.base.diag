# Makefile.base.diag — Diagnostic CEBASE build.
# Instruments src/split/module_main.c (W01-W07) and module_runtime.c (W08-W11).
# Produces: CEBASE.8xp (same name as production — replaces it in CalcEngine-Debug/)
#
# Build from repo root:
#   make -f tools/hardware-test/diag-calceng/Makefile.base.diag clean
#   make -f tools/hardware-test/diag-calceng/Makefile.base.diag
#   cp tools/hardware-test/diag-calceng/bin/base/CEBASE.8xp \
#      "C:/Users/user/Downloads/CalcEngine-Debug/"

NAME        = CEBASE
DESCRIPTION = "CalcEngine Diag Base Module"
BINDIR      = tools/hardware-test/diag-calceng/bin/base

PROGRAM_CFLAGS = \
    -DHW_BUILD_SPLIT \
    -DCE_AST_ENABLE_STAT_NAMES=0 \
    -DCE_PROC_ALG=0 -DCE_PROC_ALG_BASIC=0 -DCE_PROC_ALG_SOLVE=0 -DCE_PROC_ALG_ADV=0 \
    -DCE_PROC_CALC=0 -DCE_PROC_CALC_BASE=0 -DCE_PROC_CALC_DERIV=0 \
    -DCE_PROC_CALC_TANGENT=0 -DCE_PROC_CALC_LIMIT=0 \
    -DCE_PROC_CALC_INT=0 -DCE_PROC_CALC_INT_SYMBOLIC=0 -DCE_PROC_CALC_INT_POLAR=0 \
    -DCE_PROC_CALC_SERIES=0 -DCE_PROC_CALC_SERIES_TF=0 -DCE_PROC_CALC_SERIES_SEQ=0 \
    -DCE_PROC_STAT=0 -DCE_PROC_FIN=0 -DCE_PROC_MATRIX=0 -DCE_PROC_CMPLX=0 \
    -DCE_PROC_GRAPH=0 -DCE_PROC_GENERIC=1 -DCE_PROC_USE_CLASSIFY=0 \
    -DCE_PROC_PARSE_INPUT=0 \
    -DCE_EVAL_ENABLE_NODE_STAT=0 \
    -DCE_EVAL_ENABLE_NODE_LIST=0 \
    -DCE_EVAL_ENABLE_ADV_POLAR=0 \
    -DCE_EVAL_ENABLE_POLYDIV=0

PROGRAM_SOURCES = \
    tools/hardware-test/diag-calceng/module_main_diag.c \
    tools/hardware-test/diag-calceng/diag_helpers.c \
    src/split/runtime_globals.c \
    src/split/ipc.c \
    src/split/astwire.c \
    src/split/processor.c \
    src/memory.c \
    src/ast.c \
    src/steps.c \
    src/eval.c

# IMPORTANT: use module_runtime_diag.c here (not src/split/module_runtime.c).
# module_runtime_diag.c provides the instrumented ce_module_runtime_finish
# with W08-W11 markers.  Including both would cause a duplicate-symbol error.
PROGRAM_RUNTIME_SOURCES = tools/hardware-test/diag-calceng/module_runtime_diag.c

include tools/hardware-test/diag-calceng/program_diag.mk
